# Newchamps Gestor — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA comitar o .env real. A service role key nunca vai para o frontend.

# --- App web (Vercel / local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Somente no servidor/worker (NUNCA com prefixo NEXT_PUBLIC) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedores de IA (entram na Fase 3; deixe vazio por enquanto) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Mercado Livre (Fase 3c) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- WhatsApp (Fase 5) ---
ZAPI_TOKEN=

AGENT_ENV=desenvolvimento
